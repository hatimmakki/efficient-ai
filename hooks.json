{
  "efficient-ai": {
    "PreToolUse": [
      {
        "matcher": "run_command|read_file",
        "hooks": [
          {
            "type": "command",
            "command": "python ./hooks/eai_hook.py antigravity",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python ./hooks/eai_hook.py antigravity",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
